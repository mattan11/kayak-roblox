-- Kolejka pomostu: odliczanie od pierwszej osoby, skrót przy komplecie, „Płyń teraz”.

return function(t)
	local Config = require(t.shared.Config)
	local PierQueue = require(t.shared.PierQueue)

	local function filled(count: number, now: number)
		local queue = PierQueue.new()
		for id = 1, count do
			queue:join(id, now)
		end
		return queue
	end

	t.describe("wejście i wyjście", function()
		t.it("pusty pomost nie odlicza", function()
			local queue = PierQueue.new()
			t.expect(queue.endsAt).toBe(nil)
			t.expect(queue:tick(1000)).toBe(nil)
		end)
		t.it("pierwsza osoba włącza odliczanie, kolejne go nie przedłużają", function()
			local queue = PierQueue.new()
			t.expect(queue:join(1, 10)).toBe(true)
			t.expect(queue.endsAt).toBe(10 + Config.PIER_COUNTDOWN)
			queue:join(2, 20)
			t.expect(queue.endsAt).toBe(10 + Config.PIER_COUNTDOWN)
			t.expect(queue:count()).toBe(2)
		end)
		t.it("ten sam gracz nie wchodzi dwa razy", function()
			local queue = filled(1, 0)
			t.expect(queue:join(1, 1)).toBe(false)
			t.expect(queue:count()).toBe(1)
		end)
		t.it("wyjście ostatniego kasuje odliczanie, następny zaczyna od nowa", function()
			local queue = filled(1, 0)
			t.expect(queue:leave(1)).toBe(true)
			t.expect(queue.endsAt).toBe(nil)
			queue:join(2, 20)
			t.expect(queue.endsAt).toBe(20 + Config.PIER_COUNTDOWN)
		end)
		t.it("wyjście kogoś z kolejki nie zmienia odliczania", function()
			local queue = filled(2, 0)
			queue:leave(1)
			t.expect(queue.endsAt).toBe(Config.PIER_COUNTDOWN)
			t.expect(queue:has(2)).toBe(true)
		end)
		t.it("wyjście kogoś spoza kolejki nic nie robi", function()
			t.expect(filled(1, 0):leave(99)).toBe(false)
		end)
	end)

	t.describe("komplet", function()
		t.it("skraca odliczanie, ale nigdy go nie wydłuża", function()
			local queue = filled(Config.PIER_CAPACITY - 1, 0)
			queue:join(99, 3)
			t.expect(queue.endsAt).toBe(3 + Config.PIER_FULL_COUNTDOWN)

			local late = filled(Config.PIER_CAPACITY - 1, 0)
			late:join(99, Config.PIER_COUNTDOWN - 1)
			t.expect(late.endsAt).toBe(Config.PIER_COUNTDOWN)
		end)
		t.it("nie wpuszcza ponad limit", function()
			local queue = filled(Config.PIER_CAPACITY, 0)
			t.expect(queue:join(99, 1)).toBe(false)
			t.expect(queue:count()).toBe(Config.PIER_CAPACITY)
		end)
		t.it("po czyimś wyjściu skrócony czas zostaje", function()
			local queue = filled(Config.PIER_CAPACITY, 0)
			queue:leave(1)
			t.expect(queue.endsAt).toBe(Config.PIER_FULL_COUNTDOWN)
		end)
	end)

	t.describe("start", function()
		t.it("koniec odliczania oddaje całą grupę i czyści pomost", function()
			local queue = filled(3, 0)
			t.expect(queue:tick(Config.PIER_COUNTDOWN - 0.1)).toBe(nil)
			local group = queue:tick(Config.PIER_COUNTDOWN) :: { number }
			t.expect(#group).toBe(3)
			t.expect(queue:count()).toBe(0)
			t.expect(queue.endsAt).toBe(nil)
			t.expect(queue:tick(Config.PIER_COUNTDOWN + 1)).toBe(nil)
		end)
		t.it("„Płyń teraz” zabiera klikającego razem z całą kolejką", function()
			local queue = filled(3, 0)
			local group = queue:go(2) :: { number }
			t.expect(#group).toBe(3)
			t.expect(table.find(group, 2) ~= nil).toBe(true)
			t.expect(queue:count()).toBe(0)
		end)
		t.it("„Płyń teraz” działa solo", function()
			t.expect(#(filled(1, 0):go(1) :: { number })).toBe(1)
		end)
		t.it("„Płyń teraz” spoza kolejki nic nie robi", function()
			local queue = filled(2, 0)
			t.expect(queue:go(99)).toBe(nil)
			t.expect(queue:count()).toBe(2)
		end)
	end)
end
