-- Sterowanie: punkt na ekranie → akcja, klawisze, przytrzymanie wielu palców.

return function(t)
	local PaddleMapping = require(t.client.logic.PaddleMapping)
	local classify = PaddleMapping.classify

	local function action(kind: string, side: number)
		return { kind = kind, side = side }
	end

	t.describe("classify", function()
		t.it("domyślnie tap po prawej to wiosło po lewej, w trybie realistycznym po prawej", function()
			t.expect(PaddleMapping.paddleSide(1, false)).toBe(-1)
			t.expect(PaddleMapping.paddleSide(-1, false)).toBe(1)
			t.expect(PaddleMapping.paddleSide(1, true)).toBe(1)
		end)
		t.it("bottom: dolne pola to wbicie, górne machnięcie", function()
			t.expect(classify(100, 700, 1000, 800, "bottom").kind).toBe("brace")
			t.expect(classify(100, 700, 1000, 800, "bottom").side).toBe(-1)
			t.expect(classify(900, 100, 1000, 800, "bottom").kind).toBe("stroke")
			t.expect(classify(900, 100, 1000, 800, "bottom").side).toBe(1)
		end)
		t.it("top: odwrotnie", function()
			t.expect(classify(100, 100, 1000, 800, "top").kind).toBe("brace")
			t.expect(classify(900, 700, 1000, 800, "top").kind).toBe("stroke")
		end)
	end)

	t.describe("forKey", function()
		t.it("klawiatura i pad", function()
			t.expect(PaddleMapping.forKey("A").side).toBe(-1)
			t.expect(PaddleMapping.forKey("Right").kind).toBe("stroke")
			t.expect(PaddleMapping.forKey("E").kind).toBe("brace")
			t.expect(PaddleMapping.forKey("ButtonR2").kind).toBe("stroke")
			t.expect(PaddleMapping.forKey("ButtonL1").kind).toBe("brace")
			t.expect(PaddleMapping.forKey("Space")).toBe(nil)
		end)
	end)

	t.describe("held", function()
		t.it("dwa palce w tym samym polu: puszczenie jednego nie kończy wbicia", function()
			local held = PaddleMapping.newHeld()
			PaddleMapping.press(held, action("brace", 1))
			PaddleMapping.press(held, action("brace", 1))
			PaddleMapping.release(held, action("brace", 1))
			t.expect(PaddleMapping.braceSide(held)).toBe(1)
			PaddleMapping.release(held, action("brace", 1))
			t.expect(PaddleMapping.braceSide(held)).toBe(nil)
		end)
		t.it("obie strony wbite: wygrywa ostatnia, po puszczeniu wraca druga", function()
			local held = PaddleMapping.newHeld()
			PaddleMapping.press(held, action("brace", -1))
			PaddleMapping.press(held, action("brace", 1))
			t.expect(PaddleMapping.braceSide(held)).toBe(1)
			PaddleMapping.release(held, action("brace", 1))
			t.expect(PaddleMapping.braceSide(held)).toBe(-1)
		end)
		t.it("przytrzymanie jednej strony powtarza ją, obu: na zmianę", function()
			local held = PaddleMapping.newHeld()
			t.expect(PaddleMapping.nextHeldStroke(held)).toBe(nil)
			PaddleMapping.press(held, action("stroke", -1))
			t.expect(PaddleMapping.nextHeldStroke(held)).toBe(-1)
			t.expect(PaddleMapping.nextHeldStroke(held)).toBe(-1)
			PaddleMapping.press(held, action("stroke", 1))
			t.expect(PaddleMapping.nextHeldStroke(held)).toBe(-1)
			t.expect(PaddleMapping.nextHeldStroke(held)).toBe(1)
			t.expect(PaddleMapping.nextHeldStroke(held)).toBe(-1)
		end)
		t.it("clear puszcza wszystko (utrata okna)", function()
			local held = PaddleMapping.newHeld()
			PaddleMapping.press(held, action("stroke", 1))
			PaddleMapping.press(held, action("brace", -1))
			PaddleMapping.clear(held)
			t.expect(PaddleMapping.nextHeldStroke(held)).toBe(nil)
			t.expect(PaddleMapping.braceSide(held)).toBe(nil)
		end)
	end)
end
